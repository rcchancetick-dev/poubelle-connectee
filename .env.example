# ---- Persistance (Upstash Redis via Vercel Marketplace) ----
KV_REST_API_URL=https://votre-base.upstash.io
KV_REST_API_TOKEN=votre_token_upstash

# ---- Authentification espace admin ----
ADMIN_PASSWORD_INITIAL=ChangezMoiRapidement123!
JWT_SECRET=une_chaine_secrete_longue_et_aleatoire_a_generer

# ---- API SMS BEFIANA (Madagascar) ----
# https://help.befiana.cloud/docs/introduction-a-lutilisation-de-lapi-sms-par-befiana/
BEFIANA_API_KEY=votre_cle_api_befiana

# Numero par defaut de l'agent de collecte a alerter
# IMPORTANT (BEFIANA) : le numero ne doit PAS commencer par "0" ni par "+261".
# Format attendu par l'API : 321234567 (9 chiffres, prefixe operateur sans le 0)
DEFAULT_ALERT_NUMBER=321234567

# Cle partagee pour securiser l'endpoint appele par l'ESP32
ESP32_API_KEY=change_moi_en_production
